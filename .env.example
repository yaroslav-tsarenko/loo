# Local: path to the Obsidian vault (on Vercel guides come from ./content via `pnpm content:sync`)
VAULT_PATH="/Users/you/Documents/Obsidian Vault"
GUIDES_DIR=Guides

# Supabase Postgres — Connect → Transaction pooler (6543) for the app, Session pooler (5432) for migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local offline Postgres instead: `pnpm db:local` + DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres + DATABASE_POOL_MAX=1

# Supabase Auth (Project Settings → API / API Keys). Public values — never put the secret / service-role key here.
# Without them the app shows a setup message on /login. Dashboard setup: docs/AUTH.md
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated. First verified sign-in → role admin + claims the pre-multi-user progress.
ADMIN_EMAILS=
# Production origin for auth email links and OAuth redirects (optional; defaults to the request host)
# SITE_URL=https://<your-app>.vercel.app

# Local UI work without Supabase keys: `next dev` signs you in as the legacy owner. Ignored in builds / on Vercel.
# DEV_AUTH_BYPASS=1

# Vercel Cron → /api/cron/*
CRON_SECRET=

# Opaque quiz option ids (src/server/quiz-ids.ts). Optional: falls back to CRON_SECRET / DATABASE_URL. Changing it
# reshuffles ids — a placement test in progress then has to restart.
# QUIZ_OPTION_SECRET=

# AI reels: on Vercel AI Gateway uses OIDC automatically; locally set one of these
# AI_GATEWAY_API_KEY=
# REELS_MODEL=anthropic/claude-sonnet-5.5
# REELS_VERIFY_MODEL=anthropic/claude-haiku-5.5

# Google sign-in on our own domain (Google shows «continue to playloo.app», not the Supabase host): the same OAuth
# client as in Supabase → Auth → Providers → Google. Without the secret the Supabase redirect flow is used.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Database tuning (docs/PERFORMANCE.md) ────────────────────────────────────────────────────────────────────────
# Connections per server instance (default 3 on Vercel, 5 locally; 1 for PGlite)
# DATABASE_POOL_MAX=
# One-message statements: unset = stock driver · serial · pipeline (direct / session pooler only) · 0
# DATABASE_PIPELINE=
# A preview deployment with its OWN database may run migrations (production builds always do — scripts/migrate.ts)
# MIGRATE_ON_PREVIEW=1
# Per-request timing lines in the server log
# PERF_TRACE=1
# Course bundles kept parsed per instance (LRU, default 8 — src/server/courses/registry.ts)
# COURSE_CACHE_MAX=8
# Local dev: load the parsed content snapshot (content/.snapshot) instead of parsing the vault; 0 = no file watching
# CONTENT_SNAPSHOT=1
# CONTENT_WATCH=0

# ── Admin login for /admin (pnpm admin:credentials [--totp] writes these; docs/ANALYTICS.md) ───────────────────
# ADMIN_LOGIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
# Second factor: a base32 TOTP secret (authenticator app)
# ADMIN_TOTP_SECRET=

# ── Analytics (docs/ANALYTICS.md) ───────────────────────────────────────────────────────────────────────────────
# Salt of the visitor network tokens (falls back to CRON_SECRET); days events are kept (default 395, min 30)
# ANALYTICS_IP_SALT=
# ANALYTICS_RETENTION_DAYS=395

# ── Email reminders (GitHub Action, docs/EMAIL.md) ──────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# REMINDERS_FROM=Loo <hello@playloo.app>

# ── Blog writer (pnpm blog:write, docs/BLOG.md) ──────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# BLOG_MODEL=
# BLOG_IMAGE_MODEL=

# ── Production helpers (scripts/setup-prod.sh, scripts/check-env.ts, scripts/copy-db.ts) ────────────────────────
# PROD_DB_PASSWORD=
# SOURCE_URL=postgres://postgres@127.0.0.1:54329/postgres
