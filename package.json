{
  "name": "interview-preparation-2-0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "reminders": "tsx scripts/reminders.ts",
    "emails:build": "tsx docs/emails/build.ts",
    "ids:suggest": "tsx scripts/ids-suggest.ts",
    "content:check": "tsx --env-file-if-exists=.env.local scripts/check-guide.ts",
    "diagram:check": "tsx --env-file-if-exists=.env.local scripts/diagram-check.ts",
    "content:sync": "tsx --env-file-if-exists=.env.local scripts/content-sync.ts",
    "course:check": "tsx --env-file-if-exists=.env.local scripts/course-check.ts",
    "course:build": "tsx --env-file-if-exists=.env.local scripts/course-build.ts",
    "content:snapshot": "tsx scripts/content-snapshot.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:import-sqlite": "tsx --env-file-if-exists=.env.local scripts/import-sqlite.ts",
    "db:local": "tsx scripts/local-db.ts",
    "news:preview": "tsx scripts/news-preview.ts",
    "db:copy": "tsx --env-file-if-exists=.env.local scripts/copy-db.ts",
    "vercel-build": "tsx scripts/migrate.ts --if-configured && tsx scripts/course-build.ts --if-sources && tsx scripts/content-snapshot.ts && next build",
    "setup:prod": "bash scripts/setup-prod.sh",
    "env:secrets": "bash scripts/env-secrets.sh",
    "env:check": "tsx scripts/check-env.ts",
    "env:fill": "bash scripts/env-fill.sh"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.4.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^6.0.307",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.48.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "ts-fsrs": "^5.4.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
